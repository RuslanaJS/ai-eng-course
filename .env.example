# Copy to .env and fill in your values: cp .env.example .env
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings via the Gemini API (free tier counts every chunk as one request, about 1000 per day)
GEMINI_API_KEY=...

# Ollama runs locally; change only if the host/port differs
OLLAMA_HOST=http://localhost:11434
